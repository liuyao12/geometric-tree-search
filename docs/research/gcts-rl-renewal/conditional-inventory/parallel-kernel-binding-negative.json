  "finding": {
    "claim": "The recursive successor seals the set of functions reachable through a captured class, but no longer seals class member names or descriptor associations. Swapping two existing class methods leaves every recursively recorded function row and class closure-cell identity unchanged.",
    "dynamic_class": {
      "end": 1152,
      "line": 1148,
      "name": "Facade"
    },
    "exact_predecessor_Source": "def function_owner_seal(value):\n    need(type(value)is types.FunctionType,'owned synchronous profile callback function')\n    closure=value.__closure__\n    owners=[]\n    if closure is not None:\n        for cell in closure:\n            try:\n                content=cell.cell_contents\n                owner=id(content)\n            except ValueError:\n                content=None;owner=None\n            class_members=[]\n            if type(content)is type:\n                for name,item in sorted(vars(content).items()):\n                    if type(item)in(staticmethod,classmethod):item=item.__func__\n                    if type(item)is types.FunctionType:\n                        class_members.append((name,id(item),id(item.__code__),\n                            id(item.__defaults__),id(item.__kwdefaults__),id(item.__closure__)))\n            owners.append((id(cell),owner,tuple(class_members)))\n    return(id(value),id(value.__code__),id(value.__defaults__),id(value.__kwdefaults__),\n           id(closure),tuple(owners))",
    "exact_successor_Source": "def _recursive_function_owner_seal(value):\n    \"\"\"Also seal helper functions newly captured by observed query wrappers.\"\"\"\n    need(type(value)is types.FunctionType,'owned synchronous callback function')\n    pending=[value];seen=set();rows=[]\n    while pending:\n        fn=pending.pop()\n        if id(fn)in seen:continue\n        seen.add(id(fn));closure=fn.__closure__;cells=[]\n        if closure is not None:\n            for cell in closure:\n                try:content=cell.cell_contents\n                except ValueError:content=None\n                cells.append((id(cell),id(content)))\n                if type(content)is types.FunctionType:pending.append(content)\n                if type(content)is type:\n                    for member in vars(content).values():\n                        if type(member)in(staticmethod,classmethod):member=member.__func__\n                        if type(member)is types.FunctionType:pending.append(member)\n        rows.append((id(fn),id(fn.__code__),id(fn.__defaults__),id(fn.__kwdefaults__),id(closure),tuple(cells)))\n    return tuple(sorted(rows))",
    "executed": false,
    "function": {
      "end": 1895,
      "line": 1876,
      "name": "_recursive_function_owner_seal"
    },
