      "label": "whole_pipeline_group",
      "new": "    def run_pipeline():\n        language=fresh_language()\n        marked=adapter.MarkedSemantics(language=language,base_semantics=semantics,\n            decorator=decorator,verifier=verifier,marking=copy.deepcopy(marking),tick=tick)\n        state=marked.initial_state(language,tick)\n        need(state['selected']==[] and state['excluded']==[], 'exact fresh native root, no proof route')\n        return modules['pipeline_cases'].run_pipeline(\n            language=language,base_semantics=semantics,marked_semantics=marked,\n            engine_module=engine,router_module=modules['degree_router'],\n            legacy_proposer=modules['proposer'],marked_aware_proposer=modules['marked_aware_proposer'],\n            marked_aware_checker=modules['marked_aware_checker'],fallback_module=fallback,\n            point_module=adapter,collector=modules['state_collector'],miner=modules['family_miner'],\n            provider=modules['family_provider'],consumer=modules['family_consumer'],\n            producer=modules['family_expander'],expansion_checker=modules['family_checker'],\n            host_adapter=modules['family_adapter'],state=state,tick=tick)\n    pipeline=call(run_pipeline)\n    need(pipeline['schema']=='ROOT-engine-family-pipeline-evidence-v1'\n         and pipeline['case']==QUALIFICATION_CASES_BY_PURPOSE[plan['purpose']][0]\n         and pipeline['status'] in ('UNKNOWN','CHECKED_FRESH_BRANCH_PREFERENCE')\n         and all(pipeline[k]is False for k in ('new_theorem_discovered','proof_accepted',\n             'engine_activated','family_library_activated','degree_or_EOF_accepted','whole_engine_qualified',\n             'complete_GCTS_model_accepted','RL_accepted','GCTS_advantage_claimed','ROOT_resource_accepted')),\n         'whole bounded integration record, UNKNOWN preserved and no stronger authority')\n    payload={'schema':'ROOT-engine-family-pipeline-payload-v1','pipeline':pipeline,\n        'original_model_sources':ORIGINAL_SOURCES,'original_model_inputs':ORIGINAL_INPUTS,\n        'original_model_binding':ORIGINAL_BINDING,'marking':marking,'definition_check':definition_check,\n        'target_model_search_started':pipeline['target_model_search_started'],\n        'new_theorem_discovered':False,'logical_proof_accepted':False,'engine_activated':False,\n        'family_library_activated':False,'whole_engine_qualified':False,'complete_GCTS_model_accepted':False,\n        'scheduler_or_rollback_accepted':False,'RL_accepted':False,'GCTS_advantage_claimed':False,\n        'ROOT_resource_accepted':False}\n",
