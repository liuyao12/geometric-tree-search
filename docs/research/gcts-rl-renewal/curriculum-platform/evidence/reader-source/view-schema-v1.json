{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROOT-assembled platform-scope display only; not a qualification oracle",
  "type": "object",
  "required": [
    "schema",
    "status_note",
    "actors",
    "memory_observations",
    "phases",
    "milestone",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "ROOT-assembled-curriculum-platform-reader-v1"
    },
    "notebook": {
      "const": 115
    },
    "status_note": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "role",
          "pid",
          "parent_pid",
          "scope_note",
          "evidence_href"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "role": {
            "enum": [
              "scientific_worker",
              "owner",
              "dispatcher",
              "launcher",
              "leaf_observer",
              "calibration_worker"
            ]
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "parent_pid": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "scope_note": {
            "type": "string"
          },
          "evidence_href": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reader links only evidence/ paths without .., view.json and origins.json; unsupported links remain text."
          }
        },
        "additionalProperties": true
      }
    },
    "memory_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "method",
          "value_bytes",
          "original_value",
          "original_unit",
          "scope_note",
          "evidence_href"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "value_bytes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "original_value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "original_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope_note": {
            "type": "string"
          },
          "evidence_href": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reader links only evidence/ paths without .., view.json and origins.json; unsupported links remain text."
          }
        },
        "additionalProperties": true
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "version",
          "semantic_status",
          "resource_status",
          "root_full_owned_seconds",
          "disposition_note",
          "evidence_href"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "semantic_status": {
            "enum": [
              "pending",
              "not_run",
              "pass",
              "accepted",
              "unknown",
              "failed"
            ]
          },
          "resource_status": {
            "enum": [
              "pending",
              "not_run",
              "pass",
              "accepted",
              "unknown",
              "failed"
            ]
          },
          "root_full_owned_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "disposition_note": {
            "type": "string"
          },
          "evidence_href": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reader links only evidence/ paths without .., view.json and origins.json; unsupported links remain text."
          }
        },
        "additionalProperties": true
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "calibration",
        "next_donor",
        "ROOT_qualified",
        "claim_basis",
        "note"
      ],
      "properties": {
        "calibration": {
          "type": "object",
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "not_run",
                "pass",
                "accepted",
                "unknown",
                "failed"
              ]
            },
            "note": {
              "type": "string"
            },
            "evidence_href": {
              "type": [
                "string",
                "null"
              ],
              "description": "Reader links only evidence/ paths without .., view.json and origins.json; unsupported links remain text."
            }
          },
          "additionalProperties": true
        },
        "next_donor": {
          "type": "object",
          "required": [
            "status",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "not_run",
                "pass",
                "accepted",
                "unknown",
                "failed"
              ]
            },
            "note": {
              "type": "string"
            },
            "evidence_href": {
              "type": [
                "string",
                "null"
              ],
              "description": "Reader links only evidence/ paths without .., view.json and origins.json; unsupported links remain text."
            }
          },
          "additionalProperties": true
        },
        "ROOT_qualified": {
          "type": "boolean"
        },
        "claim_basis": {
          "enum": [
            null,
            "actual_calibration",
            "new_unexecuted_donor_progress",
            "both"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Null measurements are unavailable. Empty arrays contain no invented actor, memory or phase records. ROOT must bind units, scope overlap, actual calibrations/new donor progress and owned terminal dispositions. Design-only work cannot enable a milestone."
}
