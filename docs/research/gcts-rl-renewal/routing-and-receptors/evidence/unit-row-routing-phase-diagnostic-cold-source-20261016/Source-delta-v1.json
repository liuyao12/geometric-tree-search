      "new_utf8": "    tick();signal.signal(signal.SIGINT,cancel);signal.signal(signal.SIGTERM,cancel)\n    routing_phase_tick,routing_phase_tick_code,routing_phase_write=tick,tick.__code__,os.write\n    routing_phase_labels=('NATIVE_READY_BEFORE_PLAN', 'BEFORE_CURRENT_SOURCE_READS', 'BEFORE_CURRENT_AUTHORITY_CHECKS', 'BEFORE_FIXED_INPUT_READS', 'BEFORE_MODULE_LOAD_AND_SEAL', 'BEFORE_PRIOR_STAGEB_AUTHENTICATION', 'BEFORE_FRESH_MARKING_CHECK', 'AFTER_FRESH_MARKING_CHECK', 'BEFORE_ROUTING_SETUP', 'BEFORE_ZERO_QUERY', 'BEFORE_ONE_QUERY', 'BEFORE_TWO_QUERY', 'BEFORE_ABSENT_QUERY', 'BEFORE_IMPLICATION_QUERY', 'BEFORE_ROUTING_ASSERTIONS', 'AFTER_ROUTING_PROTOCOL')\n    def routing_phase(stage):\n        if (routing_phase is not routing_phase_fn or routing_phase_fn.__code__ is not routing_phase_code\n                or routing_phase_fn.__defaults__ is not None or routing_phase_fn.__kwdefaults__ is not None\n                or tick is not routing_phase_tick or routing_phase_tick.__code__ is not routing_phase_tick_code\n                or routing_phase_tick.__defaults__ is not None or routing_phase_tick.__kwdefaults__ is not None\n                or os.write is not routing_phase_write or type(routing_phase_write) is not types.BuiltinFunctionType):\n            raise RuntimeError('routing phase diagnostic native writer changed')\n        native_ns=routing_phase_tick()\n        if (type(stage) is not str or stage not in routing_phase_labels\n                or type(native_ns) is not int or not 0<=native_ns<2**63):\n            raise RuntimeError('routing phase diagnostic literal/native sample')\n        raw=('UNQUALIFIED_ROUTING_PHASE_OBSERVATION '+stage+' '+str(native_ns)+'\\n').encode('ascii')\n        offset=0\n        while offset<len(raw):\n            if offset:routing_phase_tick()\n            if os.write is not routing_phase_write:\n                raise RuntimeError('routing phase diagnostic native write endpoint changed')\n            count=routing_phase_write(2,raw[offset:])\n            if type(count) is not int or not 0<count<=len(raw)-offset:\n                raise RuntimeError('routing phase diagnostic incomplete native write')\n            routing_phase_tick()\n            if os.write is not routing_phase_write:\n                raise RuntimeError('routing phase diagnostic native write endpoint changed on return')\n            offset+=count\n    routing_phase_fn,routing_phase_code=routing_phase,routing_phase.__code__\n    routing_phase('NATIVE_READY_BEFORE_PLAN')\n",
