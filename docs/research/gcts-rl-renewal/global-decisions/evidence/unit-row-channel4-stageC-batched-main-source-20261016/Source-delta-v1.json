      "new_end": 64131,
      "new_start": 62899,
      "new_utf8": "    def main_seed_batch(d):\n        # Constructor-local only. Its parser budget is CUMULATIVE over all five\n        # seeds; it is never reset/reused by state_from, search or coverage.\n        fixture_language=fresh_language()\n        def seed_tile(witness, premises, reads, row):\n            pre = {'input_epoch':ORIGINAL_BINDING['language_epoch'],'primitive_witness':copy.deepcopy(witness),\n                'ordered_premise_formulas':copy.deepcopy(premises),'ordered_offsets':[k-row for k in reads]}\n            return semantics.rebuild_tile(fixture_language,pre,[0,row],tick)\n        def seed_ax(row):\n            return seed_tile({'rule':'axiom','name':ax_name,'formula':ax_formula},[],[],row)\n        def seed_ug(body, source, row):\n            return seed_tile({'rule':'generalize','variable':variable,'formula':['all',variable,copy.deepcopy(body)]},\n                        [body],[source],row)\n        try:\n            return [seed_ax(0),seed_ax(4),seed_ug(ax_formula,1,2),seed_ug(d,3,6),seed_ug(ax_formula,5,8)]\n        finally:\n            # Neither the language nor its nested constructor closures escape;\n            # only original bare JSON tile packets reach independent rebuilding.\n            del fixture_language\n\n",
      "old_end": 63358,
