"""Saved metadata/ASCII diagnostics only. Never imports or evaluates scientific Source.
A complete readout is not a qualification, proof, restoration or exhaustion claim.
"""
import hashlib,json,math,os,stat,sys,re
from pathlib import Path
HERE=Path(__file__).resolve().parent
EXPECTED_CONTRACT=__EXPECTED_CONTRACT__
VERSION='unit-row-global-forced-saved-diagnostic-reader-v1'
PURPOSE='unit-row-marked-aware-global-forced-dead-controls'
INVOCATION='global-forced-diagnostic-20261016-v1'
CLOCK_DOMAIN='time.clock_gettime_ns(time.CLOCK_MONOTONIC)'
LIMITS={'aggregate_owned_bytes':536870912,'caller_finish_reserve_seconds':1,'caller_seconds':90,'failure_only_seconds':55,'joint_seconds':20,'owned_seconds':60}
LABELS=('GF_BEFORE_SEED_STATE_GROUP','GF_BEFORE_ENGINE_ROOT_GROUP','GF_BEFORE_SEARCH_SNAPSHOT_GROUP','GF_AFTER_SEARCH_SNAPSHOT_GROUP','GF_AFTER_ASSERTIONS_GROUP','GF_AFTER_OUTER_RESTORE_GROUP','GF_BEFORE_TRANSPORT_GROUP')
ROLES=('proposer','fallback','completion','validator')
ERROR_PREFIX=b'UNIT_ROW_GLOBAL_ENGINE_UNKNOWN: '
DEADLINE_LINE=b'UNIT_ROW_GLOBAL_ENGINE_UNKNOWN: TimeoutError: complete marking data controls original20/500 reserve unfinished\n'
def need(value,reason):
    if not value:raise ValueError('saved GF diagnostic: '+reason)
def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()
def unique(items):
    value={}
    for key,child in items:need(key not in value,'duplicate JSON key');value[key]=child
    return value
def reject(value):raise ValueError('saved GF diagnostic: nonfinite JSON constant')
def finite(value):
    result=float(value);need(math.isfinite(result),'finite JSON number');return result
def decode(raw):return json.loads(raw,object_pairs_hook=unique,parse_constant=reject,parse_float=finite)
def buffer_pin(path,raw):return {'path':str(path),'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)}
def read_raw(path,cap):
    need(type(path)is Path or isinstance(path,Path),'literal saved path')
    need(path.is_absolute()and path==path.resolve(),'canonical saved path')
    fd=os.open(str(path),os.O_RDONLY|os.O_NOFOLLOW)
    try:
        info=os.fstat(fd);need(stat.S_ISREG(info.st_mode)and 0<=info.st_size<=cap,'bounded regular complete file')
        blocks=[];size=0
        while True:
            block=os.read(fd,min(65536,cap+1-size))
            if not block:break
            blocks.append(block);size+=len(block);need(size<=cap,'whole file cap and EOF')
        raw=b''.join(blocks);need(len(raw)==info.st_size,'same opened complete file size')
        return raw
    finally:os.close(fd)
def pinned(ref,cap=1048576):
    need(type(ref)is dict and set(ref)=={'path','sha256','bytes'},'exact raw capsule')
    need(type(ref['path'])is str and type(ref['bytes'])is int and 0<=ref['bytes']<=cap,'literal capsule path/size')
    need(type(ref['sha256'])is str and re.fullmatch('[0-9a-f]{64}',ref['sha256'])is not None,'literal capsule hash')
    path=Path(ref['path']);raw=read_raw(path,cap);need(buffer_pin(path,raw)==ref,'raw capsule SHA/length/EOF')
    return raw
def saved_json(path,cap=1048576):
    raw=read_raw(path,cap);return decode(raw),buffer_pin(path,raw)
def exact_int(value,low,high):return type(value)is int and low<=value<=high
def same(left,right):need(canonical(left)==canonical(right),'full literal metadata concordance')

def main():
    need(len(sys.argv)==1,'no extra arguments or scientific inputs')
    plan_path=HERE/'ROOT-GF-plan-v1.json';plan,plan_ref=saved_json(plan_path)
    need(type(plan)is dict and set(plan)=={'schema','invocation_id','purpose','output_directory','sources','inputs','source_contract','reviews','ROOT_authorization','runtime','limits','resource_rule'},'exact plan12')
    need(plan['schema']=='ROOT-routed-engine-qualification-plan-v1'and plan['purpose']==PURPOSE and plan['invocation_id']==INVOCATION,'one declared diagnostic endpoint')
    same(plan['limits'],LIMITS);need(all(type(x)is int for x in plan['limits'].values()),'literal unchanged limits')
    need(plan['resource_rule']=='single-owned-process-native-terminal-v1','native resource rule')
    same(plan['source_contract'],EXPECTED_CONTRACT);contract=decode(pinned(EXPECTED_CONTRACT))
    need(contract['schema']=='unit-row-global-forced-diagnostic-cold-Source-contract-v1','current caller contract schema')
    same(contract['sources'],plan['sources']);same(contract['inputs'],plan['inputs']);same(contract['limits'],LIMITS)
    need(len(plan['sources'])==14 and len(plan['inputs'])==8 and len(contract['original_model_sources'])==17 and len(contract['original_model_inputs'])==2,'current14/input8 and original17/input2')
    same(contract['source'],plan['sources']['intake'])
    for group in(plan['sources'],plan['inputs'],contract['original_model_sources'],contract['original_model_inputs']):
        for ref in group.values():pinned(ref,4*1048576+131072)
    same(contract['original_model_inputs'],{k:plan['inputs'][k]for k in('declaration','profile')})
    pinned(plan['runtime']);need(set(plan['reviews'])=={'ROOT','peer'},'two distinct Source reviews')
    for role,ref in plan['reviews'].items():
        review=decode(pinned(ref));need(review['scope']=='unit-row-global-forced-diagnostic-cold-Source'and review['author_identity']=='/root/hilbert_advice_controls','current author and review scope')
        same(review['source'],contract['source']);same(review['source_contract'],EXPECTED_CONTRACT);same(review['sources'],plan['sources'])
        need(review['source_only']is review['source_review_passed']is True and type(review['scientific_calls'])is int and review['scientific_calls']==0 and review['scientific_acceptance']is False,'genuine Source-only pass')
        need(review['reviewer_identity']=='/root'if role=='ROOT'else review['reviewer_identity']not in('/root','/root/hilbert_advice_controls'),'distinct reviewer identity')
    need(Path(plan['ROOT_authorization']['path'])==HERE/'ROOT-GF-authorization-v1.json','fixed Root grant file')
    grant=decode(pinned(plan['ROOT_authorization']))
    need(grant['schema']=='ROOT-routed-engine-qualification-authorization-v1'and grant['author_identity']=='/root'and grant['actual_execution_authorized']is True and type(grant['maximum_actual_invocations'])is int and grant['maximum_actual_invocations']==1,'once Root grant')
    for key in('invocation_id','purpose','sources','inputs','source_contract','reviews','runtime','limits','resource_rule','output_directory'):same(grant[key],plan[key])
    external=HERE/'GF-external-v1';owned=HERE/'GF-owned-v1';need(Path(plan['output_directory'])==owned,'fixed owned directory')
    bracket,bracket_ref=saved_json(HERE/'ROOT-GF-tool-bracket-v1.json')
    need(bracket['schema']=='ROOT-complete-tool-Date-bracket-v1'and bracket['plan_sha256']==plan_ref['sha256']and bracket['plan_bytes']==plan_ref['bytes'],'same plan tool bracket')
    code=bracket['tool_exit_code'];need(exact_int(code,0,255),'terminal literal tool exit')
    sid,seen=bracket['tool_session_id'],bracket['observed_session_id']
    need((sid is None and seen is None)or(exact_int(sid,1,2**63-1)and type(seen)is int and seen==sid),'same terminal session or none')
    need(bracket.get('unchanged_actual_restarted')is False,'no unchanged restart')
    need(type(bracket['began_Date_ms'])is int and type(bracket['ended_Date_ms'])is int,'literal Date bounds')
    duration=(bracket['ended_Date_ms']-bracket['began_Date_ms'])/1000
    need(duration==bracket['complete_Date_seconds']and 0<=duration<=60 and duration+1<=90,'whole tool Date/caller closure')
    names=('ONCE.json','native-terminal.json','observation.json','meter-stdout.txt','meter-stderr.txt','postterminal-probe-stdout.txt','postterminal-probe-stderr.txt')
    raw={name:read_raw(external/name,65536 if name=='meter-stderr.txt'else 1048576)for name in names}
    refs={name:buffer_pin(external/name,value)for name,value in raw.items()}
    once,native,observation=(decode(raw[name])for name in('ONCE.json','native-terminal.json','observation.json'))
    need(once['schema']=='ROOT-ordinary-once-consumed-v1'and observation['schema']=='ROOT-ordinary-external-observation-v1','once/native observation schemas')
    for value in(once,observation):
        need(value['plan_sha256']==plan_ref['sha256']and value['plan_bytes']==plan_ref['bytes']and value['invocation_id']==INVOCATION and value['purpose']==PURPOSE,'consumed same once plan/invocation/purpose')
    need(native['schema']=='ROOT-Q-native-terminal-meter-v1'and native['version']=='Q-external-native-terminal-meter-Source-v2-global-clock'and native['CLOCK_DOMAIN']==CLOCK_DOMAIN,'existing meter2/same native clock')
    need(native['utility_argv']==[plan['runtime']['path'],'-I','-S','-B',contract['source']['path'],str(plan_path)],'actual utility argv/current Source/runtime/plan')
    need(type(native['caller_returncode'])is int and native['caller_returncode']==observation['meter_returncode']==code and type(native['wait4_status'])is int and native['wait4_status']==code*256,'terminal exit/wait4status')
    need(type(observation['probe_returncode'])is int and observation['probe_returncode']==0 and type(observation['meter_returncode'])is int and native['all_reaped']is True and type(native['wait4_pid'])is int and native['caller_pid']==native['wait4_pid']and exact_int(native['caller_pid'],1,2**63-1),'same owned pid/reaped/probe')
    need(native['error']is None and native['interrupted']is native['cancellation_forwarded']is False,'clean terminal meter closure')
    need(native['all_strong_acceptance_false']is True and observation['measurement_only']is True,'external measurement-only scope')
    for value in(native,observation):
        need(value['ROOT_resource_accepted']is value['ROOT_primary_accepted']is False,'native pending flags')
    need(raw['postterminal-probe-stderr.txt']==b'','empty probe stderr')
    probe_raw=raw['postterminal-probe-stdout.txt'];need(re.fullmatch(rb'(0|[1-9][0-9]*)\n',probe_raw)is not None,'whole literal probe scalar LF')
    probe=int(probe_raw);need(probe==observation['postterminal_native_probe_ns'],'same saved postterminal probe')
    start,terminal=native['caller_launch_began_ns'],native['caller_terminal_observed_ns']
    need(all(exact_int(x,0,2**63-1)for x in(start,terminal,probe,native['meter_began_ns'],native['observed_before_output_ns'],observation['external_began_ns']))and observation['external_began_ns']<=native['meter_began_ns']<=start<terminal<=native['observed_before_output_ns']<=probe and type(native['caller_kernel_elapsed_ns'])is int and terminal-start==native['caller_kernel_elapsed_ns']and probe-start<55000000000,'complete native failure55 closure')
    peak=native['caller_kernel_peak_bytes'];need(type(peak)is int and peak==native['wait4_usage'][2]and 0<peak<=536870912,'whole owned peak512')
    stderr=raw['meter-stderr.txt'];need(len(stderr)<=672+2200 and stderr.isascii(),'bounded ASCII diagnostic stderr')
    samples=[];error_line=None;last=-1;marker_bytes=0
    for line in stderr.splitlines(keepends=True):
        need(line.endswith(b'\n'),'whole stderr line LF')
        if line.startswith(ERROR_PREFIX):
            need(error_line is None and len(line)<=2200,'one separate bounded existing error line')
            error_line=line.decode('ascii');continue
        need(error_line is None and len(line)<=96,'sample before error, bounded marker')
        match=re.fullmatch(rb'([A-Z0-9_]+) (0|[1-9][0-9]*)\n',line);need(match is not None,'fixed label canonical unsigned decimal LF')
        label=match.group(1).decode('ascii');need(label in LABELS,'one fixed marker label');index=LABELS.index(label)
        need(index>last,'unique ordered marker subsequence');last=index
        sample=int(match.group(2));need(exact_int(sample,0,2**63-1)and start<=sample<terminal<=probe,'same-clock launch/sample/terminal/probe')
        need(not samples or samples[-1]['native_ns']<=sample,'nondecreasing native samples')
        marker_bytes+=len(line);samples.append({'label':label,'native_ns':sample})
    need(len(samples)<=7 and marker_bytes<=672,'seven marker wire cap')
    diagnostic=None;diagnostic_status='ABSENT';diagnostic_refs={};outputs=[];scientific_outputs=[]
    if owned.exists():
        need(owned.is_dir()and not owned.is_symlink(),'owned regular directory')
        permitted={'unknown-diagnostic.json':16384,'diagnostic-completion.json':1024,'engine-result.json':4194304,'response.jsonl':1048576}
        for path in sorted(owned.iterdir()):
            need(path.name in permitted,'only current diagnostic or scientific raw output files')
            content=read_raw(path,permitted[path.name]);ref=buffer_pin(path,content);outputs.append(ref)
            if path.name in('unknown-diagnostic.json','diagnostic-completion.json'):diagnostic_refs[path.name]=ref
            else:scientific_outputs.append(ref)
        need(not diagnostic_refs or not scientific_outputs,'separate current failure-writer and scientific output routes')
        present=set(diagnostic_refs)
        if present:
            diagnostic_status='INCOMPLETE_WRITER_OUTPUT'
            if present=={'unknown-diagnostic.json','diagnostic-completion.json'}:
                diagnostic_raw=pinned(diagnostic_refs['unknown-diagnostic.json'],16384)
                completion_raw=pinned(diagnostic_refs['diagnostic-completion.json'],1024)
                need(diagnostic_raw.endswith(b'\n')and diagnostic_raw.count(b'\n')==1 and completion_raw.endswith(b'\n')and completion_raw.count(b'\n')==1,'whole diagnostic/completion single JSON LF')
                diagnostic=decode(diagnostic_raw);completion=decode(completion_raw)
                need(set(completion)=={'schema','file','sha256','bytes','diagnostic_only','positive_joint_gate_accepted','ROOT_resource_accepted','terminal_exit2_and_external_failure_closure_required'},'whole completion fields')
                need(completion['schema']=='unit-row-controls-last-context-completion-v1'and completion['file']=='unknown-diagnostic.json'and completion['sha256']==diagnostic_refs['unknown-diagnostic.json']['sha256']and completion['bytes']==diagnostic_refs['unknown-diagnostic.json']['bytes'],'diagnostic full hash/bytes join')
                need(completion['diagnostic_only']is completion['terminal_exit2_and_external_failure_closure_required']is True and completion['positive_joint_gate_accepted']is completion['ROOT_resource_accepted']is False,'completion diagnostic-only flags')
                need(code==2 and error_line is not None and error_line.startswith('UNIT_ROW_GLOBAL_ENGINE_UNKNOWN: TimeoutError: '),'failure writer exact exception/terminal route')
                need(type(diagnostic)is dict and set(diagnostic)=={'context','diagnostic','last_observations'},'exact whole scalar diagnostic envelope')
                same(diagnostic['diagnostic'],{'schema':'unit-row-controls-last-context-diagnostic-v1','diagnostic_only':True,'qualification':'UNQUALIFIED_LAST_ADAPTER_NATIVE_OBSERVATIONS','failure_kind':'TimeoutError','returned_control_record':False,'callback_context':'ENTRY_ARGUMENT_ROW_AND_SELECTED_COUNT_AT_LAST_SUCCESSFUL_EXISTING_NATIVE_CHECK','last_observation_is_active_failure_frame':False,'live_state_or_proof_trajectory_accepted':False,'positive_joint_gate_accepted':False,'logical_proof_accepted':False,'exact_point_board_accepted':False,'complete_GCTS_model_accepted':False,'GCTS_search_trajectory_accepted':False,'RL_accepted':False,'ROOT_resource_accepted':False})
                context=diagnostic['context']
                need(type(context)is dict and set(context)=={'purpose','invocation_id','plan','source_contract','sources','inputs','language_binding','joint_began_ns','joint_deadline_ns','CLOCK_DOMAIN','limits'},'exact predelegation context fields')
                same(context['plan'],{k:plan_ref[k]for k in('sha256','bytes')});same(context['source_contract'],EXPECTED_CONTRACT)
                same(context['sources'],plan['sources']);same(context['inputs'],plan['inputs']);same(context['limits'],LIMITS)
                same(context['language_binding'],contract['original_model_binding'])
                need(context['purpose']==PURPOSE and context['invocation_id']==INVOCATION and context['CLOCK_DOMAIN']==CLOCK_DOMAIN,'same predelegation purpose/invocation/clock')
                began,deadline=context['joint_began_ns'],context['joint_deadline_ns']
                need(exact_int(began,0,2**63-1)and exact_int(deadline,0,2**63-1)and start<=began<terminal and deadline==began+20000000000,'original20 G/D and native lifetime')
                observations=diagnostic['last_observations'];need(type(observations)is dict and set(observations)==set(ROLES),'fixed four scalar slots')
                need(observations['validator']is None,'validator explicitly uninstrumented')
                for role,value in observations.items():
                    if value is None:continue
                    need(type(value)is dict and set(value)=={'stage','row','selected_count','native_ns'},'exact scalar entry packet')
                    need(type(value['stage'])is str and value['stage']==role.upper()+'_NATIVE_STEP'and exact_int(value['row'],-1,23)and exact_int(value['selected_count'],-1,24),'entry scalar literal types/ranges')
                    need(exact_int(value['native_ns'],0,2**63-1)and began<=value['native_ns']<deadline and start<=value['native_ns']<terminal<=probe,'entry sample same original clock/window')
                diagnostic_status='COMPLETE_HASH_JOINED_FAILURE_ONLY_DIAGNOSTIC'
    clock_context=None;slots=None
    if diagnostic_status=='COMPLETE_HASH_JOINED_FAILURE_ONLY_DIAGNOSTIC':
        clock_context={key:diagnostic['context'][key]for key in('joint_began_ns','joint_deadline_ns','CLOCK_DOMAIN')}
        slots=diagnostic['last_observations']
        need(all(clock_context['joint_began_ns']<=value['native_ns']<clock_context['joint_deadline_ns']for value in samples),'all markers in same original positive window')
    intervals=[{'from':left['label'],'to':right['label'],'inclusive_read_to_read_ns':right['native_ns']-left['native_ns'],'includes_all_between_observed_reads':True,'exclusive_method_cost':False}for left,right in zip(samples,samples[1:])]
    if code==0:
        need(error_line is None and not diagnostic_refs and {Path(ref['path']).name for ref in scientific_outputs}=={'engine-result.json','response.jsonl'},'success keeps both raw outputs and no failure line for separate reconciliation')
        stdout=raw['meter-stdout.txt'];need(stdout.endswith(b'\n')and stdout.count(b'\n')==1,'complete positive final metadata LF')
        final=decode(stdout);need(canonical(final)+b'\n'==stdout and final['schema']=='ROOT-unit-row-routed-engine-qualification-final-observation-v1','existing final raw-output metadata')
        same(final['outputs'],scientific_outputs);same(final['response'],scientific_outputs[-1])
        need(final['pending_external']is True and final['logical_proof_accepted']is final['ROOT_resource_accepted']is False,'positive metadata still pending separate closure')
        classification='NEEDS_SEPARATE_COMPLETE_QUALIFICATION_RECONCILIATION'
    else:
        need(raw['meter-stdout.txt']==b'','no fabricated positive stdout for nonzero terminal')
        classification='UNQUALIFIED_FAILURE_DIAGNOSTIC_ONLY'
    result={'schema':'ROOT-global-forced-saved-diagnostic-readout-v1','version':VERSION,'diagnostic_only':True,
      'classification':classification,'plan':plan_ref,'authorization':plan['ROOT_authorization'],'source_contract':EXPECTED_CONTRACT,'sources':plan['sources'],'inputs':plan['inputs'],
      'original_model_sources':contract['original_model_sources'],'original_model_inputs':contract['original_model_inputs'],'original_model_binding':contract['original_model_binding'],
      'tool_bracket':bracket_ref,'native_evidence':refs,'terminal_exit_code':code,'all_reaped':True,'native_terminal_closed':True,'native_worker_lifetime_ns':terminal-start,'native_launch_to_postprobe_ns':probe-start,'aggregate_B_bytes':peak,'complete_Date_seconds':duration,
      'raw_stderr':refs['meter-stderr.txt'],'stderr_error_line':error_line,'native_deadline_confirmed':stderr.endswith(DEADLINE_LINE)and terminal-start>=20000000000,
      'phase_samples':samples,'phase_marker_wire_bytes':marker_bytes,'first_reached_boundary':samples[0]['label']if samples else None,'latest_reached_boundary':samples[-1]['label']if samples else None,'inclusive_group_intervals':intervals,
      'original20_clock_context':clock_context,'latest_callback_entry_observations':slots,'diagnostic_status':diagnostic_status,'failure_diagnostic_files':diagnostic_refs,'raw_output_files':outputs,'raw_scientific_output_files':scientific_outputs,'owned_output_directory_exists':owned.exists(),
      'successful_payload_requires_separate_reconciliation':code==0,'reader':buffer_pin(Path(__file__).resolve(),read_raw(Path(__file__).resolve(),1048576)),
      'reported_case_count':None,'qualified_case_count':0,'case_completion_inferred':False,'qualification_accepted':False,'original20_positive_gate_accepted':False,'native_resource_success_accepted':False,'logical_proof_accepted':False,'exact_point_board_accepted':False,'restoration_accepted':False,'exhaustion_accepted':False,'trajectory_accepted':False,'marking_activated':False,'GCTS_advantage_claimed':False,'RL_accepted':False,'scientific_replay':False,
      'interpretation':'Observed reached writes and callback entry arguments only. Inclusive read-to-read groups include guards, nested work, marker IO and gaps; no exclusive cost, current active frame, completed callback, move/count, restored root, proof or exhaustion is inferred. Missing slots or writes are unavailable, never zero/absence evidence. Original20 positive acceptance requires separate full scientific-record closure; failure55 data supplies diagnostics only.'}
    path=HERE/'ROOT-GF-diagnostic-readout-v1.json';raw_result=json.dumps(result,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False).encode()+b'\n'
    need(len(raw_result)<=131072,'bounded metadata-only readout128KiB')
    with path.open('xb')as stream:stream.write(raw_result)
    print(json.dumps({'readout':buffer_pin(path,raw_result),'classification':classification,'qualification_accepted':False,'scientific_replay':False}))
if __name__=='__main__':main()
