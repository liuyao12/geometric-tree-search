+def _goal_point_view(graph):
+    """Small original state view for read-only advice; no domain snapshot copy."""
+    return {'model_epoch': graph.model_epoch, 'roots': list(graph.roots),
+        'totals': list(graph.totals), 'order': [k.data() for k in graph.order],
+        'marks': [[x, y, v, graph.mark_refs[(x, y)]]
+                  for (x, y), v in sorted(graph.marks.items())],
+        'excluded': [[k.data() for k in sorted(row)] for row in graph.excluded]}
+
