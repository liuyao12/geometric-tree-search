+def _priority_base_key(graph, point_module, row, recipe_order, budget):
+    """Same existing Factor products, reordered only; no degree recomputation.
+
+    Each choice scans ALL original recipe ranks until the first available key.
+    Original graph counts/singletons and final legal check remain authoritative
+    for producer scheduling. No candidate is removed by this preference.
+    """
+    factors = {f.recipe: f for f in graph.domains[row].factors}
+    for index in recipe_order:
+        budget.check()
+        factor = factors.get(index)
+        if factor is None:
+            continue
+        recipe = graph.recipes[index]
+        if not recipe.inputs:
+            refs = [()]
+        elif len(recipe.inputs) == 1:
+            refs = ((a,) for a in point_module.set_bits(factor.left))
+        else:
+            refs = ((a, b) for a in point_module.set_bits(factor.left)
+                    for b in point_module.set_bits(factor.right)
+                    if not factor.different or a != b)
+        for ports in refs:
+            budget.check()
+            key = point_module.Key(index, row, ports)
+            if key not in graph.excluded[row]:
+                need(graph.legal(key), 'same complete original factor candidate')
+                return key
+    raise ValueError('positive original domain has no remaining base alternative')
+
