{
  "API": {
    "check_decorated_tile": {
      "meaning": "Derives c354 original bare tile from offered selection_record, full original membership/preimage/ports/translation, derives extra arrays and complete decorated ID, then compares whole offered packet. This does not decide current-state legality.",
      "returns": "Full independently rebuilt unit-row-row0-decorated-tile-v1 packet, exact decorator wire including all nine data flags false. No receipt wrapper.",
      "signature": "check_decorated_tile(*, language, semantics, marking, tile, tick)"
    },
    "check_marked_state": {
      "fields": [
        "schema",
        "version",
        "marking_id",
        "marking_sha256",
        "original_binding",
        "original_state_sha256",
        "marked_state_sha256",
        "selected_count",
        "added_mark_points",
        "all_required_t_filled",
        "marked_state_checked",
        "projection_literals_rechecked",
        "scope",
        "logical_proof_accepted",
        "exact_point_board_accepted",
        "complete_GCTS_model_accepted",
        "marking_activated",
        "trajectory_accepted",
        "degree_or_EOF_accepted",
        "GCTS_advantage_accepted",
        "RL_accepted",
        "ROOT_resource_accepted"
      ],
      "meaning": "Full original c354 private_state reconstruction, all selected decorated packets and exact channel4 union. all_required_t_filled is a diagnostic, not original1717/whole-word proof acceptance.",
      "returns": "unit-row-channel4-marked-state-check-v1",
      "signature": "check_marked_state(*, language, semantics, marking, state, tick)"
    },
    "check_marking": {
      "fields": [
        "schema",
        "version",
        "marking",
        "marking_id",
        "marking_sha256",
        "original_binding",
        "marking_checked",
        "projection_literals_rechecked",
        "logical_proof_accepted",
        "exact_point_board_accepted",
        "complete_GCTS_model_accepted",
        "marking_activated",
        "trajectory_accepted",
        "GCTS_advantage_accepted",
        "RL_accepted",
        "ROOT_resource_accepted",
        "degree_or_EOF_accepted"
      ],
      "meaning": "Full independently reconstructed frozen marking returned, with narrow check booleans true. No independently_checked field is emitted in this receipt; broad acceptance flags are false.",
      "returns": "unit-row-channel4-marking-check-v1",
      "signature": "check_marking(*, language, semantics, marking, tick)"
    },
    "errors": {
      "actual_point_conflict": "ValueError: channel4 verifier: channel4 point agreement",
      "full_state_or_missing_guard": "ValueError: channel4 verifier: whole original plus extra marking state/union",
      "other": "Specific authority/census/collision errors and unchanged c354/membership errors propagate. Missing malformed fields can raise builtin errors. No exception, resource failure or incomplete calculation becomes a definite candidate rejection, ZERO, EOF or proof.",
      "whole_model": "ValueError: channel4 verifier: whole frozen marking definition/evidence/identity",
      "whole_tile": "ValueError: channel4 verifier: whole independently rebuilt decorated tile"
    }
  },
