-
-def _canonical(value):
-    return json.dumps(value, sort_keys=True, separators=(',', ':'),
-                      ensure_ascii=True, allow_nan=False)
-
-
-def _digest(value):
-    return hashlib.sha256(_canonical(value).encode('ascii')).hexdigest()
